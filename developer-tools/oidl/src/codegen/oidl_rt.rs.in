//!
//! The support every generated module uses: the wire format's readers and writers (§7), the
//! descriptors a kernel decoder produces (§10) and the error type a client returns (§8).
//! `no_std`, no allocation, no `unsafe`, no panics.
#![forbid(unsafe_code)]
#![deny(
    clippy::panic,
    clippy::unwrap_used,
    clippy::expect_used,
    clippy::indexing_slicing,
    clippy::arithmetic_side_effects,
    clippy::cast_possible_truncation
)]

use core::fmt;
use core::marker::PhantomData;

/// Bytes of the message header (§7.1).
pub const HEADER_SIZE: usize = 16;
/// Wire format revision of this specification (§7.1).
pub const WIRE_REVISION: u8 = 1;
/// A request.
pub const KIND_REQUEST: u8 = 1;
/// A response.
pub const KIND_RESPONSE: u8 = 2;
/// An error reply.
pub const KIND_ERROR: u8 = 3;
/// The hello's ordinal (§7.7).
pub const HELLO_ORDINAL: u32 = 0;
/// Bytes of the hello's body (§7.7).
pub const HELLO_BODY_SIZE: usize = 16;
/// The slot of an absent `optional<handle>` (§7.4).
pub const ABSENT_SLOT: u32 = u32::MAX;

/// Why a message was refused. Each is the reason a decoder gives first, in the order of
/// `docs/spec/OIDL.md` §7.5.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
#[non_exhaustive]
pub enum WireError {
    /// The length is not what the specification requires.
    Size,
    /// The wire revision is unknown.
    Wire,
    /// The kind is unknown.
    Kind,
    /// The kind is valid but not the one expected here.
    Direction,
    /// A reserved field is not zero.
    Reserved,
    /// The transaction id breaks its rule.
    Txid,
    /// The ordinal is unknown here.
    Ordinal,
    /// A padding byte is not zero.
    Padding,
    /// A boolean is not 0 or 1.
    Bool,
    /// An enum value is not a declared member.
    Enum,
    /// A bit is set that is not declared.
    Bits,
    /// A `@nonzero` value is zero.
    Nonzero,
    /// A count exceeds its bound.
    Count,
    /// A string is not valid UTF-8.
    Utf8,
    /// A string contains a NUL.
    Nul,
    /// The handles do not match the message.
    HandleCount,
    /// A handle slot is not the next index.
    HandleSlot,
    /// A handle is not of the declared object type.
    HandleType,
    /// A handle lacks a declared right.
    HandleRights,
    /// An encoder was given no value for a field the negotiated minor includes.
    Missing,
    /// A hello reply negotiated a minor the client did not offer.
    Version,
}

impl WireError {
    /// The reason's name in the hostile corpus (§14).
    pub const fn name(self) -> &'static str {
        match self {
            Self::Size => "size",
            Self::Wire => "wire",
            Self::Kind => "kind",
            Self::Direction => "direction",
            Self::Reserved => "reserved",
            Self::Txid => "txid",
            Self::Ordinal => "ordinal",
            Self::Padding => "padding",
            Self::Bool => "bool",
            Self::Enum => "enum",
            Self::Bits => "bits",
            Self::Nonzero => "nonzero",
            Self::Count => "count",
            Self::Utf8 => "utf8",
            Self::Nul => "nul",
            Self::HandleCount => "handle_count",
            Self::HandleSlot => "handle_slot",
            Self::HandleType => "handle_type",
            Self::HandleRights => "handle_rights",
            Self::Missing => "missing",
            Self::Version => "version",
        }
    }
}

/// `len` rounded up to a multiple of 8.
pub const fn round_up_8(len: usize) -> usize {
    len.saturating_add(7) & !7
}

/// The bytes of a variable part: `(count, element size)` for each vector and string, each
/// rounded up to a multiple of 8 (§7.3).
pub fn variable_size(parts: &[(u32, usize)]) -> usize {
    let mut total = 0usize;
    for (count, element) in parts {
        let count = usize::try_from(*count).unwrap_or(usize::MAX);
        total = total.saturating_add(round_up_8(count.saturating_mul(*element)));
    }
    total
}

/// A boolean at a boundary: 0 is false, 1 is true and every other byte is refused, never
/// coerced (CLAUDE.md §10).
pub const fn decode_bool(raw: u8) -> Option<bool> {
    match raw {
        0 => Some(false),
        1 => Some(true),
        _ => None,
    }
}

/// `bytes[at..at + len]`, or [`WireError::Size`].
pub fn slice_at(bytes: &[u8], at: usize, len: usize) -> Result<&[u8], WireError> {
    let end = at.checked_add(len).ok_or(WireError::Size)?;
    bytes.get(at..end).ok_or(WireError::Size)
}

/// Fails unless `len` bytes at `at` are zero (§5.2).
pub fn check_zero(bytes: &[u8], at: usize, len: usize) -> Result<(), WireError> {
    if slice_at(bytes, at, len)?.iter().all(|b| *b == 0) {
        Ok(())
    } else {
        Err(WireError::Padding)
    }
}

/// A fixed-size type (§3).
pub trait Fixed: Copy {
    /// Its size in bytes.
    const SIZE: usize;
    /// A value that fills an array while the array is decoded. Never returned.
    const FILLER: Self;
    /// Decodes and validates exactly `Self::SIZE` bytes, at `minor` of its library.
    fn read(bytes: &[u8], minor: u16) -> Result<Self, WireError>;
    /// Encodes into exactly `Self::SIZE` bytes.
    fn write(self, out: &mut [u8]) -> Result<(), WireError>;
}

/// Zero-fills `len` bytes at `at` (§5.2).
pub fn zero_fill(out: &mut [u8], at: usize, len: usize) -> Result<(), WireError> {
    let end = at.checked_add(len).ok_or(WireError::Size)?;
    out.get_mut(at..end).ok_or(WireError::Size)?.fill(0);
    Ok(())
}

/// A `string` argument the kernel has copied (§3): valid UTF-8 with no NUL. The register decoder
/// never reads user memory, so the kernel calls this after its copy.
pub fn check_string(bytes: &[u8]) -> Result<&str, WireError> {
    let text = core::str::from_utf8(bytes).map_err(|_| WireError::Utf8)?;
    if bytes.contains(&0) {
        return Err(WireError::Nul);
    }
    Ok(text)
}

/// Reads and validates the `T` at `at`.
pub fn field<T: Fixed>(bytes: &[u8], at: usize, minor: u16) -> Result<T, WireError> {
    T::read(slice_at(bytes, at, T::SIZE)?, minor)
}

/// Writes `value` at `at`.
pub fn put_field<T: Fixed>(out: &mut [u8], at: usize, value: T) -> Result<(), WireError> {
    let end = at.checked_add(T::SIZE).ok_or(WireError::Size)?;
    value.write(out.get_mut(at..end).ok_or(WireError::Size)?)
}

macro_rules! fixed_int {
    ($($ty:ty),*) => {$(
        impl Fixed for $ty {
            const SIZE: usize = core::mem::size_of::<$ty>();
            const FILLER: Self = 0;
            fn read(bytes: &[u8], _minor: u16) -> Result<Self, WireError> {
                let raw: [u8; core::mem::size_of::<$ty>()] =
                    bytes.try_into().map_err(|_| WireError::Size)?;
                Ok(<$ty>::from_le_bytes(raw))
            }
            fn write(self, out: &mut [u8]) -> Result<(), WireError> {
                if out.len() != Self::SIZE {
                    return Err(WireError::Size);
                }
                out.copy_from_slice(&self.to_le_bytes());
                Ok(())
            }
        }
    )*};
}
fixed_int!(u8, u16, u32, u64, i8, i16, i32, i64);

impl Fixed for bool {
    const SIZE: usize = 1;
    const FILLER: Self = false;
    fn read(bytes: &[u8], _minor: u16) -> Result<Self, WireError> {
        match bytes {
            [raw] => decode_bool(*raw).ok_or(WireError::Bool),
            _ => Err(WireError::Size),
        }
    }
    fn write(self, out: &mut [u8]) -> Result<(), WireError> {
        match out {
            [slot] => {
                *slot = u8::from(self);
                Ok(())
            }
            _ => Err(WireError::Size),
        }
    }
}

impl<T: Fixed, const N: usize> Fixed for [T; N] {
    const SIZE: usize = T::SIZE.saturating_mul(N);
    const FILLER: Self = [T::FILLER; N];
    fn read(bytes: &[u8], minor: u16) -> Result<Self, WireError> {
        if bytes.len() != Self::SIZE {
            return Err(WireError::Size);
        }
        let mut out = Self::FILLER;
        for (index, slot) in out.iter_mut().enumerate() {
            *slot = field::<T>(bytes, index.saturating_mul(T::SIZE), minor)?;
        }
        Ok(out)
    }
    fn write(self, out: &mut [u8]) -> Result<(), WireError> {
        if out.len() != Self::SIZE {
            return Err(WireError::Size);
        }
        for (index, item) in self.into_iter().enumerate() {
            put_field(out, index.saturating_mul(T::SIZE), item)?;
        }
        Ok(())
    }
}

/// A handle: an opaque name for a kernel object (ADR-0011 N9).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
#[repr(transparent)]
pub struct Handle(u32);

impl Handle {
    /// Never a valid handle.
    pub const INVALID: Self = Self(0);

    /// The transport layer's way to make one. Not part of the SDK.
    #[doc(hidden)]
    pub const fn from_abi(raw: u32) -> Self {
        Self(raw)
    }

    /// The transport layer's way to read one. Not part of the SDK.
    #[doc(hidden)]
    pub const fn to_abi(self) -> u32 {
        self.0
    }

    /// Whether this could name an object.
    pub const fn is_valid(self) -> bool {
        self.0 != 0
    }
}

impl Fixed for Handle {
    const SIZE: usize = 4;
    const FILLER: Self = Self(0);
    fn read(bytes: &[u8], minor: u16) -> Result<Self, WireError> {
        u32::read(bytes, minor).map(Self)
    }
    fn write(self, out: &mut [u8]) -> Result<(), WireError> {
        self.0.write(out)
    }
}

/// A handle as a transport received it: its value and what the kernel reports about it (§7.4).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct RecvHandle {
    /// The handle.
    pub value: Handle,
    /// Its object type (a value of `object_type`).
    pub object: u32,
    /// Its rights (bits of `rights`).
    pub rights: u32,
}

/// The handles delivered with a message, consumed in slot order (§7.4).
#[derive(Debug)]
pub struct HandleList<'h> {
    list: &'h [RecvHandle],
    used: usize,
}

impl<'h> HandleList<'h> {
    /// The list delivered with a message.
    pub const fn new(list: &'h [RecvHandle]) -> Self {
        Self { list, used: 0 }
    }

    /// The handle for a required slot.
    pub fn take(&mut self, slot: u32, object: u32, rights: u32) -> Result<RecvHandle, WireError> {
        if usize::try_from(slot).ok() != Some(self.used) {
            return Err(WireError::HandleSlot);
        }
        let handle = *self.list.get(self.used).ok_or(WireError::HandleCount)?;
        self.used = self.used.saturating_add(1);
        if object != 0 && handle.object != object {
            return Err(WireError::HandleType);
        }
        if handle.rights & rights != rights {
            return Err(WireError::HandleRights);
        }
        Ok(handle)
    }

    /// The handle for an optional slot.
    pub fn take_optional(
        &mut self,
        slot: u32,
        object: u32,
        rights: u32,
    ) -> Result<Option<RecvHandle>, WireError> {
        if slot == ABSENT_SLOT {
            Ok(None)
        } else {
            self.take(slot, object, rights).map(Some)
        }
    }

    /// How many have been consumed.
    pub const fn used(&self) -> usize {
        self.used
    }

    /// `count` handles from `start`, for a decoded `vector<handle>`.
    pub fn run(&self, start: usize, count: usize) -> Result<&'h [RecvHandle], WireError> {
        let end = start.checked_add(count).ok_or(WireError::HandleCount)?;
        self.list.get(start..end).ok_or(WireError::HandleCount)
    }

    /// Fails unless every handle has been consumed.
    pub fn finish(&self) -> Result<(), WireError> {
        if self.used == self.list.len() {
            Ok(())
        } else {
            Err(WireError::HandleCount)
        }
    }
}

/// Collects the handles of a message being encoded, assigning each its slot.
#[derive(Debug)]
pub struct HandleSink<'a> {
    out: &'a mut [u32],
    used: usize,
}

impl<'a> HandleSink<'a> {
    /// Handles will be written into `out`.
    pub fn new(out: &'a mut [u32]) -> Self {
        Self { out, used: 0 }
    }

    /// Adds `handle` and returns its slot.
    pub fn put(&mut self, handle: Handle) -> Result<u32, WireError> {
        let slot = u32::try_from(self.used).map_err(|_| WireError::HandleCount)?;
        let target = self.out.get_mut(self.used).ok_or(WireError::HandleCount)?;
        *target = handle.to_abi();
        self.used = self.used.saturating_add(1);
        Ok(slot)
    }

    /// How many handles have been added.
    pub const fn used(&self) -> usize {
        self.used
    }
}

/// A validated run of decoded `T`s inside a message (§7.2).
pub struct View<'a, T> {
    bytes: &'a [u8],
    count: usize,
    minor: u16,
    element: PhantomData<T>,
}

impl<T> Clone for View<'_, T> {
    fn clone(&self) -> Self {
        *self
    }
}

impl<T> Copy for View<'_, T> {}

impl<'a, T: Fixed> View<'a, T> {
    /// How many elements it has.
    pub const fn count(&self) -> usize {
        self.count
    }

    /// Whether it has none.
    pub const fn is_empty(&self) -> bool {
        self.count == 0
    }

    /// The elements' raw bytes.
    pub const fn as_bytes(&self) -> &'a [u8] {
        self.bytes
    }

    /// The element at `index`.
    pub fn get(&self, index: usize) -> Option<T> {
        if index < self.count {
            field::<T>(self.bytes, index.saturating_mul(T::SIZE), self.minor).ok()
        } else {
            None
        }
    }

    /// Every element.
    pub fn iter(&self) -> impl Iterator<Item = T> + use<'a, '_, T> {
        (0..self.count).filter_map(|index| self.get(index))
    }
}

impl<T: Fixed + fmt::Debug> fmt::Debug for View<'_, T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_list().entries(self.iter()).finish()
    }
}

impl<T: Fixed> PartialEq for View<'_, T> {
    fn eq(&self, other: &Self) -> bool {
        self.count == other.count && self.bytes == other.bytes
    }
}

impl<T: Fixed> Eq for View<'_, T> {}

/// Reads one message body (§7.2, §7.5).
#[derive(Debug)]
pub struct Reader<'a> {
    body: &'a [u8],
    inline: usize,
    at: usize,
}

impl<'a> Reader<'a> {
    /// A reader for `body`, whose inline part is `inline` bytes.
    pub const fn new(body: &'a [u8], inline: usize) -> Result<Self, WireError> {
        if body.len() < inline {
            return Err(WireError::Size);
        }
        Ok(Self {
            body,
            inline,
            at: inline,
        })
    }

    /// The `T` at offset `at` of the inline part.
    pub fn field<T: Fixed>(&self, at: usize, minor: u16) -> Result<T, WireError> {
        field(self.body, at, minor)
    }

    /// Checks padding in the inline part.
    pub fn zero(&self, at: usize, len: usize) -> Result<(), WireError> {
        check_zero(self.body, at, len)
    }

    /// A vector's count, checked against its bound.
    pub fn count(&self, at: usize, max: u32) -> Result<u32, WireError> {
        let count: u32 = self.field(at, 0)?;
        if count > max {
            Err(WireError::Count)
        } else {
            Ok(count)
        }
    }

    /// Fails unless the body's length is exactly the inline part plus `variable` bytes (§7.3).
    pub fn expect_total(&self, variable: usize) -> Result<(), WireError> {
        let total = self.inline.saturating_add(variable);
        if total == self.body.len() {
            Ok(())
        } else {
            Err(WireError::Size)
        }
    }

    fn skip(&mut self, len: usize) -> Result<(), WireError> {
        let rounded = round_up_8(len);
        let end = self.at.saturating_add(len);
        check_zero(self.body, end, rounded.saturating_sub(len))?;
        self.at = self.at.saturating_add(rounded);
        Ok(())
    }

    /// The next vector of `count` `T`s, each validated.
    pub fn vector<T: Fixed>(&mut self, count: u32, minor: u16) -> Result<View<'a, T>, WireError> {
        let count = usize::try_from(count).map_err(|_| WireError::Count)?;
        let len = count.checked_mul(T::SIZE).ok_or(WireError::Size)?;
        let bytes = slice_at(self.body, self.at, len)?;
        let mut offset = 0;
        while offset < len {
            field::<T>(bytes, offset, minor)?;
            offset = offset.saturating_add(T::SIZE);
        }
        self.skip(len)?;
        Ok(View {
            bytes,
            count,
            minor,
            element: PhantomData,
        })
    }

    /// The next string of `count` bytes: valid UTF-8 with no NUL (§3).
    pub fn string(&mut self, count: u32) -> Result<&'a str, WireError> {
        let len = usize::try_from(count).map_err(|_| WireError::Count)?;
        let bytes = slice_at(self.body, self.at, len)?;
        let text = core::str::from_utf8(bytes).map_err(|_| WireError::Utf8)?;
        if bytes.contains(&0) {
            return Err(WireError::Nul);
        }
        self.skip(len)?;
        Ok(text)
    }

    /// The next `count` handle slots, consumed from `handles` (§7.4).
    pub fn handles<'h>(
        &mut self,
        count: u32,
        handles: &mut HandleList<'h>,
        object: u32,
        rights: u32,
    ) -> Result<&'h [RecvHandle], WireError> {
        let count = usize::try_from(count).map_err(|_| WireError::Count)?;
        let len = count.checked_mul(4).ok_or(WireError::Size)?;
        let start = handles.used();
        let mut offset = 0;
        while offset < len {
            let slot: u32 = field(self.body, self.at.saturating_add(offset), 0)?;
            handles.take(slot, object, rights)?;
            offset = offset.saturating_add(4);
        }
        self.skip(len)?;
        handles.run(start, count)
    }
}

/// Writes one message body (§7.2), zero-filling its padding.
#[derive(Debug)]
pub struct Writer<'a> {
    out: &'a mut [u8],
    at: usize,
}

impl<'a> Writer<'a> {
    /// A writer into `out`, whose inline part is `inline` bytes.
    pub fn new(out: &'a mut [u8], inline: usize) -> Result<Self, WireError> {
        out.get_mut(..inline).ok_or(WireError::Size)?.fill(0);
        Ok(Self { out, at: inline })
    }

    /// Writes `value` at `at` in the inline part.
    pub fn put<T: Fixed>(&mut self, at: usize, value: T) -> Result<(), WireError> {
        put_field(self.out, at, value)
    }

    /// Writes a vector's count, refusing one over its bound.
    pub fn count(&mut self, at: usize, count: usize, max: u32) -> Result<(), WireError> {
        let count = u32::try_from(count).map_err(|_| WireError::Count)?;
        if count > max {
            return Err(WireError::Count);
        }
        self.put(at, count)
    }

    fn zeros(&mut self, len: usize) -> Result<(), WireError> {
        let end = self.at.checked_add(len).ok_or(WireError::Size)?;
        self.out
            .get_mut(self.at..end)
            .ok_or(WireError::Size)?
            .fill(0);
        self.at = end;
        Ok(())
    }

    fn pad(&mut self, len: usize) -> Result<(), WireError> {
        self.zeros(round_up_8(len).saturating_sub(len))
    }

    /// Writes the next vector.
    pub fn vector<T: Fixed>(&mut self, items: &[T]) -> Result<(), WireError> {
        for item in items {
            put_field(self.out, self.at, *item)?;
            self.at = self.at.saturating_add(T::SIZE);
        }
        self.pad(items.len().saturating_mul(T::SIZE))
    }

    /// Writes the next string, refusing a NUL (§3).
    pub fn string(&mut self, text: &str) -> Result<(), WireError> {
        let bytes = text.as_bytes();
        if bytes.contains(&0) {
            return Err(WireError::Nul);
        }
        let end = self.at.checked_add(bytes.len()).ok_or(WireError::Size)?;
        self.out
            .get_mut(self.at..end)
            .ok_or(WireError::Size)?
            .copy_from_slice(bytes);
        self.at = end;
        self.pad(bytes.len())
    }

    /// Writes the next vector of handle slots.
    pub fn handles(
        &mut self,
        items: &[Handle],
        sink: &mut HandleSink<'_>,
    ) -> Result<(), WireError> {
        for handle in items {
            let slot = sink.put(*handle)?;
            put_field(self.out, self.at, slot)?;
            self.at = self.at.saturating_add(4);
        }
        self.pad(items.len().saturating_mul(4))
    }

    /// The bytes written so far.
    pub const fn size(&self) -> usize {
        self.at
    }
}

/// A validated message header (§7.1).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Header {
    /// Total bytes of the message.
    pub size: u32,
    /// Request, response or error.
    pub kind: u8,
    /// The method's ordinal.
    pub ordinal: u32,
    /// The transaction id.
    pub txid: u32,
}

/// Reads and validates the header (§7.1, §7.5 step 1).
pub fn read_header(message: &[u8]) -> Result<Header, WireError> {
    if message.len() < HEADER_SIZE {
        return Err(WireError::Size);
    }
    let size: u32 = field(message, 0, 0)?;
    if usize::try_from(size).ok() != Some(message.len()) || message.len() & 7 != 0 {
        return Err(WireError::Size);
    }
    let wire: u8 = field(message, 4, 0)?;
    if wire != WIRE_REVISION {
        return Err(WireError::Wire);
    }
    let kind: u8 = field(message, 5, 0)?;
    if !matches!(kind, KIND_REQUEST | KIND_RESPONSE | KIND_ERROR) {
        return Err(WireError::Kind);
    }
    let reserved: u16 = field(message, 6, 0)?;
    if reserved != 0 {
        return Err(WireError::Reserved);
    }
    Ok(Header {
        size,
        kind,
        ordinal: field(message, 8, 0)?,
        txid: field(message, 12, 0)?,
    })
}

/// Writes a header for a message of `total` bytes.
pub fn write_header(
    out: &mut [u8],
    kind: u8,
    ordinal: u32,
    txid: u32,
    total: usize,
) -> Result<(), WireError> {
    let size = u32::try_from(total).map_err(|_| WireError::Size)?;
    put_field(out, 0, size)?;
    put_field(out, 4, WIRE_REVISION)?;
    put_field(out, 5, kind)?;
    put_field(out, 6, 0u16)?;
    put_field(out, 8, ordinal)?;
    put_field(out, 12, txid)
}

/// Writes an error reply: one `i64` status (§7.6). Returns its total size.
pub fn write_error(
    out: &mut [u8],
    ordinal: u32,
    txid: u32,
    status: i64,
) -> Result<usize, WireError> {
    let total = HEADER_SIZE.saturating_add(8);
    write_header(out, KIND_ERROR, ordinal, txid, total)?;
    put_field(out, HEADER_SIZE, status)?;
    Ok(total)
}

/// The status of an error reply's body (§7.6): exactly one negative `i64`.
pub fn read_error_status(body: &[u8]) -> Result<i64, WireError> {
    if body.len() != 8 {
        return Err(WireError::Size);
    }
    let status: i64 = field(body, 0, 0)?;
    if status >= 0 {
        return Err(WireError::Enum);
    }
    Ok(status)
}

/// The hello's fields (§7.7).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Hello {
    /// Which interface.
    pub interface_id: u64,
    /// The sender's major version.
    pub major: u16,
    /// The client's highest minor, or the negotiated one.
    pub minor: u16,
}

/// Writes a hello. Returns its total size.
pub fn write_hello(out: &mut [u8], kind: u8, txid: u32, hello: Hello) -> Result<usize, WireError> {
    let total = HEADER_SIZE.saturating_add(HELLO_BODY_SIZE);
    write_header(out, kind, HELLO_ORDINAL, txid, total)?;
    put_field(out, HEADER_SIZE, hello.interface_id)?;
    put_field(out, HEADER_SIZE.saturating_add(8), hello.major)?;
    put_field(out, HEADER_SIZE.saturating_add(10), hello.minor)?;
    put_field(out, HEADER_SIZE.saturating_add(12), 0u32)?;
    Ok(total)
}

/// Reads a hello's body.
pub fn read_hello_body(body: &[u8]) -> Result<Hello, WireError> {
    if body.len() != HELLO_BODY_SIZE {
        return Err(WireError::Size);
    }
    let reserved: u32 = field(body, 12, 0)?;
    if reserved != 0 {
        return Err(WireError::Reserved);
    }
    Ok(Hello {
        interface_id: field(body, 0, 0)?,
        major: field(body, 8, 0)?,
        minor: field(body, 10, 0)?,
    })
}

/// Validates a hello reply on the client side (§7.7): returns the negotiated minor. `offered`
/// is the minor the client sent; a reply naming a higher one is a protocol error.
pub fn read_hello_reply(
    message: &[u8],
    handles: usize,
    interface_id: u64,
    major: u16,
    offered: u16,
) -> Result<u16, CallError<core::convert::Infallible>> {
    let header = read_header(message).map_err(CallError::Protocol)?;
    if header.ordinal != HELLO_ORDINAL || header.txid != 1 {
        return Err(CallError::Protocol(WireError::Ordinal));
    }
    if handles != 0 {
        return Err(CallError::Protocol(WireError::HandleCount));
    }
    let body = message.get(HEADER_SIZE..).unwrap_or(&[]);
    if header.kind == KIND_ERROR {
        return Err(CallError::Refused(
            read_error_status(body).map_err(CallError::Protocol)?,
        ));
    }
    if header.kind != KIND_RESPONSE {
        return Err(CallError::Protocol(WireError::Direction));
    }
    let answer = read_hello_body(body).map_err(CallError::Protocol)?;
    if answer.interface_id != interface_id || answer.major != major {
        return Err(CallError::Protocol(WireError::Ordinal));
    }
    if answer.minor > offered {
        return Err(CallError::Protocol(WireError::Version));
    }
    Ok(answer.minor)
}

/// A connection's state: the minor agreed by the hello (§7.7).
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
pub struct Connection {
    minor: Option<u16>,
}

impl Connection {
    /// A new connection, before the hello.
    pub const fn new() -> Self {
        Self { minor: None }
    }

    /// The negotiated minor, if the hello has happened.
    pub const fn negotiated(&self) -> Option<u16> {
        self.minor
    }

    /// Records the negotiated minor.
    pub fn set(&mut self, minor: u16) {
        self.minor = Some(minor);
    }
}

/// What the caller of a generated dispatcher must do next (§7.8).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Dispatched {
    /// Send this reply. `taken` says the service was given the received handles; if it is
    /// false they must be closed.
    Reply {
        /// Bytes of the reply.
        bytes: usize,
        /// Handles of the reply.
        handles: usize,
        /// Whether the service took the received handles.
        taken: bool,
    },
    /// Nothing to send.
    NoReply {
        /// Whether the service took the received handles.
        taken: bool,
    },
    /// Close the connection: the peer broke the protocol, or the service's reply could not
    /// be encoded. `taken` says whether the service was given the received handles; if it is
    /// false they must be closed.
    Close {
        /// Whether the service took the received handles.
        taken: bool,
    },
}

/// An error reply, or nothing for a one-way request (`txid` 0).
pub fn refuse(reply: &mut [u8], ordinal: u32, txid: u32, status: i64) -> Dispatched {
    if txid == 0 {
        return Dispatched::NoReply { taken: false };
    }
    match write_error(reply, ordinal, txid, status) {
        Ok(bytes) => Dispatched::Reply {
            bytes,
            handles: 0,
            taken: false,
        },
        Err(_) => Dispatched::Close { taken: false },
    }
}

/// An error reply for a method the service ran.
pub fn method_error(reply: &mut [u8], ordinal: u32, txid: u32, status: i64) -> Dispatched {
    match write_error(reply, ordinal, txid, status) {
        Ok(bytes) => Dispatched::Reply {
            bytes,
            handles: 0,
            taken: true,
        },
        Err(_) => Dispatched::Close { taken: true },
    }
}

/// The identity of an interface for [`answer_hello`].
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct HelloConfig {
    /// `INTERFACE_ID`.
    pub interface_id: u64,
    /// Its major version.
    pub major: u16,
    /// Its minor version.
    pub minor: u16,
    /// The status for a hello this interface refuses.
    pub not_supported: i64,
}

/// The server side of the hello (§7.7): `Close` for a repeated or malformed hello, an error
/// reply for the wrong interface or major, otherwise the negotiated minor.
pub fn answer_hello(
    connection: &mut Connection,
    header: Header,
    body: &[u8],
    handles: &[RecvHandle],
    config: HelloConfig,
    reply: &mut [u8],
) -> Dispatched {
    if connection.negotiated().is_some() || header.txid == 0 || !handles.is_empty() {
        return Dispatched::Close { taken: false };
    }
    let Ok(hello) = read_hello_body(body) else {
        return Dispatched::Close { taken: false };
    };
    if hello.interface_id != config.interface_id || hello.major != config.major {
        return refuse(reply, HELLO_ORDINAL, header.txid, config.not_supported);
    }
    let minor = hello.minor.min(config.minor);
    let answer = Hello {
        interface_id: config.interface_id,
        major: config.major,
        minor,
    };
    match write_hello(reply, KIND_RESPONSE, header.txid, answer) {
        Ok(bytes) => {
            connection.set(minor);
            Dispatched::Reply {
                bytes,
                handles: 0,
                taken: false,
            }
        }
        Err(_) => Dispatched::Close { taken: false },
    }
}

/// A method's own errors (§8).
pub trait MethodError: Sized + Copy {
    /// The declared error for a status, if any.
    fn from_status(status: i64) -> Option<Self>;
    /// The status of this error.
    fn status(self) -> i64;
}

/// How a call failed, as a client sees it (§8).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
#[non_exhaustive]
pub enum CallError<E> {
    /// One of the method's declared errors.
    Method(E),
    /// A refusal: `invalid_args`, `not_supported` or `access_denied` (§7.8).
    Refused(i64),
    /// A status the method does not declare.
    Undeclared(i64),
    /// The reply failed validation (§7.5).
    Protocol(WireError),
    /// The transport itself failed.
    Transport(i64),
}

/// Maps a status with no result to the client's error type.
pub fn check_status<E: MethodError>(status: i64) -> Result<(), CallError<E>> {
    if status == 0 {
        Ok(())
    } else {
        match E::from_status(status) {
            Some(error) => Err(CallError::Method(error)),
            None => Err(CallError::Undeclared(status)),
        }
    }
}

/// How a client reaches a service (ADR-0005 P8). `buffer` holds the request (and on return the
/// response).
pub trait Transport {
    /// Sends `request` bytes of `buffer` with `handles`, and receives the reply into `buffer`
    /// and `received`: returns the reply's byte and handle counts.
    fn call(
        &mut self,
        buffer: &mut [u8],
        request: usize,
        handles: &[u32],
        received: &mut [RecvHandle],
    ) -> Result<(usize, usize), i64>;

    /// Sends a one-way message.
    fn send(&mut self, buffer: &[u8], handles: &[u32]) -> Result<(), i64>;

    /// Closes handles received with a reply that a client refused (§7.8).
    fn discard(&mut self, handles: &[RecvHandle]);
}

/// Buffers for one call: the same bytes hold the request and then the reply.
#[derive(Debug)]
pub struct Scratch<'a> {
    /// Message bytes.
    pub bytes: &'a mut [u8],
    /// Handles to send.
    pub handles: &'a mut [u32],
    /// Handles received.
    pub received: &'a mut [RecvHandle],
}

/// A stack buffer aligned for any field type, used to encode a struct for a system call.
#[derive(Debug)]
#[repr(C, align(8))]
pub struct Aligned<const N: usize>(pub [u8; N]);

impl<const N: usize> Aligned<N> {
    /// A zeroed buffer.
    pub const fn new() -> Self {
        Self([0; N])
    }
}

impl<const N: usize> Default for Aligned<N> {
    fn default() -> Self {
        Self::new()
    }
}

/// A user pointer and element count for a parameter (§10), checked against its bound. The
/// decoder never dereferences it.
#[derive(Debug)]
pub struct UserSlice<T> {
    addr: u64,
    count: usize,
    element: PhantomData<T>,
}

impl<T> Clone for UserSlice<T> {
    fn clone(&self) -> Self {
        *self
    }
}

impl<T> Copy for UserSlice<T> {}

impl<T: Fixed> UserSlice<T> {
    /// `None` if `count` is over `max`.
    pub fn new(addr: u64, count: u64, max: u32) -> Option<Self> {
        if count > u64::from(max) {
            return None;
        }
        Some(Self {
            addr,
            count: usize::try_from(count).ok()?,
            element: PhantomData,
        })
    }

    /// The address.
    pub const fn addr(&self) -> u64 {
        self.addr
    }

    /// The element count.
    pub const fn count(&self) -> usize {
        self.count
    }

    /// Its length in bytes.
    pub const fn byte_len(&self) -> u64 {
        (self.count as u64).saturating_mul(T::SIZE as u64)
    }
}

/// A `vector<handle>` parameter: a [`UserSlice`] and what each handle must be.
#[derive(Clone, Copy, Debug)]
pub struct HandleSlice {
    /// The handles.
    pub slice: UserSlice<Handle>,
    /// The rights each must have.
    pub need_rights: u32,
    /// The object type each must be, or 0.
    pub need_object: u32,
}

/// A user pointer and capacity for a result (§10); a capacity above the bound is clamped.
#[derive(Debug)]
pub struct UserBuffer<T> {
    addr: u64,
    capacity: usize,
    element: PhantomData<T>,
}

impl<T> Clone for UserBuffer<T> {
    fn clone(&self) -> Self {
        *self
    }
}

impl<T> Copy for UserBuffer<T> {}

impl<T: Fixed> UserBuffer<T> {
    /// A descriptor, the capacity clamped to `max`.
    pub fn new(addr: u64, capacity: u64, max: u32) -> Self {
        Self {
            addr,
            capacity: usize::try_from(capacity.min(u64::from(max))).unwrap_or(0),
            element: PhantomData,
        }
    }

    /// The address.
    pub const fn addr(&self) -> u64 {
        self.addr
    }

    /// The capacity in elements.
    pub const fn capacity(&self) -> usize {
        self.capacity
    }

    /// The capacity in bytes.
    pub const fn byte_len(&self) -> u64 {
        (self.capacity as u64).saturating_mul(T::SIZE as u64)
    }
}

/// A user pointer to one `T` (§10).
#[derive(Debug)]
pub struct UserRef<T> {
    addr: u64,
    element: PhantomData<T>,
}

impl<T> Clone for UserRef<T> {
    fn clone(&self) -> Self {
        *self
    }
}

impl<T> Copy for UserRef<T> {}

impl<T> UserRef<T> {
    /// A descriptor for `addr`.
    pub const fn new(addr: u64) -> Self {
        Self {
            addr,
            element: PhantomData,
        }
    }

    /// The address.
    pub const fn addr(&self) -> u64 {
        self.addr
    }
}

/// A handle argument of a system call, decoded (§10): its value and what the kernel must check
/// about it (§6).
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct HandleArg {
    value: u32,
    need_rights: u32,
    need_object: u32,
}

impl HandleArg {
    /// `None` if the register holds more than 32 bits.
    pub fn from_reg(raw: u64, need_rights: u32, need_object: u32) -> Option<Self> {
        Some(Self {
            value: u32::try_from(raw).ok()?,
            need_rights,
            need_object,
        })
    }

    /// The handle's value.
    pub const fn value(self) -> u32 {
        self.value
    }

    /// The rights the kernel must find on it.
    pub const fn need_rights(self) -> u32 {
        self.need_rights
    }

    /// The object type the kernel must find, or 0 for any.
    pub const fn need_object(self) -> u32 {
        self.need_object
    }
}
